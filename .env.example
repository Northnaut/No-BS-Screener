BOT_TOKEN=your_telegram_bot_token_here
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DB_PATH=bot.db

# Discovery cycle. Reddit requests are throttled process-wide (their rate limit is per-IP),
# so a cycle can't finish faster than roughly (reddit sources x throttle interval). At ~16
# subreddits that's ~100s for Reddit alone — setting this below the achievable cycle time
# just makes APScheduler silently skip runs (max_instances=1), it does not poll more often.
POLL_INTERVAL_MINUTES=5
NEWSPAPER_POLL_INTERVAL_MINUTES=6
POSTS_PER_FETCH=25

# Newspapers are polled in strict least-recently-checked rotation, so full coverage of all
# ~38 feeds takes (38 / NEWSPAPER_SOURCES_PER_CYCLE) * NEWSPAPER_POLL_INTERVAL_MINUTES.
NEWSPAPER_SOURCES_PER_CYCLE=5

# A user drains 60/NEWSPAPER_ALERT_INTERVAL_MINUTES items per hour (4 at 15 min), so the
# queue cap is also a staleness cap: 8 items ~= 2 hours of backlog.
NEWSPAPER_ALERT_INTERVAL_MINUTES=15
NEWSPAPER_QUEUE_MAX_PER_USER=8

# One AI call per platform group per tick. Smaller batches limit the blast radius of a
# malformed reply and keep requests inside the Groq fallback's accepted size.
CLASSIFICATION_BATCH_INTERVAL_MINUTES=2
CLASSIFICATION_BATCH_MAX_POSTS=25

TG_API_ID=your_telegram_api_id_here
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION_STRING=your_telegram_session_string_here
